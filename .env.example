# Server / shared (never commit real values)
# Supabase "Session pooler" URI (Connect → Session pooler). Leave unset to use the in-memory store.
DATABASE_URL=postgresql://postgres.PLACEHOLDER:PLACEHOLDER@aws-0-PLACEHOLDER.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PLACEHOLDER.supabase.co
SUPABASE_JWT_JWKS_URL=https://PLACEHOLDER.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE_KEY
# Must be exactly 64 hex chars (32 bytes) or valid base64 encoding 32 bytes
CODE_ENCRYPTION_KEY_v1=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CODE_FINGERPRINT_PEPPER=dev-fingerprint-pepper
GUEST_TOKEN_PEPPER=dev-guest-pepper
PAYMENT_PROVIDER=fake
WAVE_API_BASE_URL=https://api.wave.com
WAVE_API_KEY=PLACEHOLDER_WAVE_CHECKOUT_API_KEY
WAVE_SIGNING_SECRET=PLACEHOLDER_WAVE_REQUEST_SIGNING_SECRET
WAVE_WEBHOOK_SECRET=PLACEHOLDER_WAVE_WEBHOOK_SECRET
# Optional: keep the previous secret during webhook secret rotation
WAVE_WEBHOOK_SECRET_PREVIOUS=
WAVE_REFUND_API_KEY=PLACEHOLDER_WAVE_REFUND_API_KEY
# Order emails. "log" prints emails to the API console (development only).
EMAIL_PROVIDER=log
RESEND_API_KEY=PLACEHOLDER_RESEND_API_KEY
# Must use a domain verified in Resend; onboarding@resend.dev only reaches the Resend account owner.
EMAIL_FROM=Carte PSN Abidjan <commandes@PLACEHOLDER_DOMAIN>
EMAIL_REPLY_TO=
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
ADMIN_BOOTSTRAP_USER_ID=PLACEHOLDER_UUID
# Dev-only: bypass JWT with X-Dev-User-Id / X-Dev-User-Email headers (never in production)
AUTH_DEV_BYPASS=false

# Client-visible (public)
NEXT_PUBLIC_SUPABASE_URL=https://PLACEHOLDER.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_ANON_KEY
NEXT_PUBLIC_API_URL=http://localhost:3001
